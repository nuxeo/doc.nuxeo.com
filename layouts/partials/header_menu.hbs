<div id="menu-top">
  <div class="container">
    <div class="top-menu--left">
      <div class="menu-item menu-item--first">
        <a href="https://doc.nuxeo.com/">
          <span class="main-menu--logo svg"><svg xmlns="http://www.w3.org/2000/svg" viewBox="211.5 100 1407 233.7"><path fill="#fff" d="M1008.7 177.4h-26.2l-45.2 79.1h26.2zm135.6 78.9H1128l-49.3-55.5v55.5H1061v-79h18.6l46.8 53v-53h17.8zm36.4-36.3v-42.6h18.3v41.1c0 14 6.5 23 22.8 23s22.7-9 22.7-23v-41.1h18.3v42.5c0 23-13.6 37.7-41 37.7s-41.1-14.8-41.1-37.7m158-16.8 23-25.7h22.5L1350 215l37.4 41.2h-23.1l-25.8-29-26 29H1290l37.2-41.1-34.2-37.8h23zm156.1-25.7V193h-58.5v15.2h52.3v15.5h-52.3v16.8h58.5v15.7h-76.5v-79zm123.8 39.5c0 23.5-19.7 40.6-46.9 40.6s-47-17.1-47-40.6 19.7-40.7 47-40.7 46.9 17.1 46.9 40.7m-75.2 0c0 15 11.8 24.7 28.3 24.7s28.2-9.8 28.2-24.7-11.8-24.8-28.2-24.8-28.3 9.8-28.3 24.8M295.7 177v78.6h-18.3v-32.4h-47.6v32.4h-18.3V177h18.3v30.7h47.5V177zm94.5 0h21.5l-39 46v32.6h-18.4V223l-39.2-46h22l26.6 31.1zm41 0h18.3v63h53v15.6h-71.3zm150.9 0 39 78.6h-19.8l-8.3-16.8h-43l-8.4 16.8H522l39.4-78.6zm-24.8 46.7h28.4L571.5 195zm166.2 32h-16l-49.1-55.4v55.3h-17.8V177h18.5l46.7 52.7V177h17.7zm31-78.7h41c28.1 0 45.7 15.4 45.7 39.5s-17.6 39.6-45.7 39.6h-41zm40.6 63.3c17 0 27-9.4 27-23.8s-10-23.7-27.1-23.7h-22.7v47.5zm77-59.7v14.7h-4.3v-14.7h-8V177H880v3.6zm22.1 14.7-6.2-14v14h-4.2V177h6.5l5.7 13 5.7-13h6.3v18.3h-4.1v-14l-6.3 14z"/></svg></span>
        </a>
      </div>
      <div class="menu-item drop-menu">
        <span class="drop-menu__parent for-desktop">Documentation <span class="svg svg--arrow-space">{{inline_svg '/assets/imgs/icons/chevron-down.min.svg'}}</span></span>
        <div id="main_menu" class="drop-menu__items">
          <div class="nav-container">
            <ul>
              <li><a href="/" class="is-grey end-of-section">Docs Home</a></li>
              {{#each site.main_menu as |menu_item|}}
              <li class="section-{{menu_item.section_color}}">
                <a href="{{menu_item.page}}">{{page_title menu_item.page}}</a>
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="top-menu--right">
      <div class="menu-item menu-item--search for-desktop">
        <form action="/search/" method="get" id="search-box">
          <div id="menu-search-input" class="search-input">
            {{! SearchBox widget will appear here }}
          </div>
        </form>
        <div id="menu-search-icon" class="nav-main__item">
          <i class="fa fa-search"></i>
        </div>
        <div id="algolia_search_results" style="display: none;">
          <div class="scrollable">
            <div id="menu-hits">
              {{! Hits widget will appear here }}
            </div>
          </div>
        </div>
      </div>
      <div id="whats_new" class="menu-item drop-menu drop-menu--persist for-desktop for-desktop--large" style="position: absolute; right: 0;">
        <span class="drop-menu__parent whats-new"><span class="whats-new__icon svg">{{inline_svg '/assets/imgs/icons/notif.min.svg'}}</span> What's New</span>
        <div class="drop-menu__items drop-menu__items--news">
          <div class="nav-container">
            <ul>
              {{#each whats_new as |news_item|}}
              <li><a href="{{news_item.url}}">
                <div class="drop-menu__date" {{#if @first}}id="whats_new_latest" data-date="{{news_item.date}}"{{/if}}>{{moment news_item.date format='ll'}}</div>
                <div class="drop-menu__title">{{news_item.title}}</div>
                <div class="drop-menu__more{{#if @last}} drop-menu__more--last{{/if}}">Read More</div>
              </a></li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>

      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</div>
